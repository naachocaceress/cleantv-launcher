<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Starting dock, in this order. After that the dock is edited on the TV (hold OK or press Menu on an app)
         and saved on the device. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>   <!-- Prime Video -->
        <item>com.google.android.youtube.tv</item>
        <item>com.disney.disneyplus</item>
        <item>com.crunchyroll.crunchyroid</item>
        <item>com.stremio.one</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.amazon.tv.livetv</item>
        <item>com.mediatek.opapp</item>      <!-- 16 European satellite-provider shortcuts -->
        <item>com.amazon.smarthomemapviewapp</item>  <!-- Alexa Smart Home -->
        <item>com.amazon.spiderpork</item>   <!-- Luna -->
        <item>com.amazon.bueller.music</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.amazon.tv.livetv</string>

    <!-- Optional: an https link to your own wallpaper list (a JSON array of {"title","credit","url"}), added to the
         built-in catalog. Leave empty to use only the built-in one. -->
    <string name="wallpaper_catalog_url" translatable="false"></string>

    <!-- Tiles per row in the grid. -->
    <integer name="columns">4</integer>

    <!-- The most apps the dock can hold (never below columns, capped at 12). -->
    <integer name="dock_max">8</integer>

    <!-- How close the dock icons sit: the dock area (the grid's width, about 750dp on a TV) is split into this many
         icon cells and the dock is centred in them. More cells = icons closer together. 9 gives about 83dp between
         icon centres (icons are 56dp); 8 is roomier, 11 is tight. Never below dock_max, capped at 30. -->
    <integer name="dock_slots">9</integer>
</resources>
